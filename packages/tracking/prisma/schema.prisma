generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
  engineType    = "binary"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  userId           String           @id @map("id")
  email            String           @unique @db.VarChar(256)
  created          DateTime         @default(now())
  name             String           @map("full_name") @db.VarChar(256)
  profilePicture   String           @map("profile_picture")
  carryOverEnabled Boolean          @default(false) @map("carry_over_enabled")
  updated          DateTime         @updatedAt
  expenses         Expense[]
  incomes          Income[]
  incomeCategories IncomeCategory[]
  Invest           Invest[]
  loan             Loan[]
  monthlyLimits    MonthlyLimit[]

  @@index([email], map: "user_email_index")
}

model Expense {
  id              Bytes     @id
  amount          Float
  description     String?   @db.VarChar(128)
  date            DateTime
  created         DateTime  @default(now())
  updated         DateTime  @updatedAt
  userId          String
  categoryId      Bytes?
  category        Category? @relation(fields: [categoryId], references: [id])
  user            User      @relation(fields: [userId], references: [userId])
  // Set when a recurring rule generated this entry. Not a foreign key:
  // deleting a rule leaves its past entries untouched.
  recurringRuleId Bytes?
  occurrenceDate  DateTime?

  @@unique([recurringRuleId, occurrenceDate], map: "expense_recurring_occurrence_unique")
  @@index([userId, date], map: "expense_user_id_date_index")
  @@index([categoryId], map: "expense_category_id_index")
  @@index([userId, updated], map: "expense_user_id_updated_index")
}

model Category {
  id       Bytes     @id
  name     String    @db.VarChar(128)
  icon     String    @db.VarChar(128)
  color    String    @db.VarChar(32)
  created  DateTime  @default(now())
  updated  DateTime  @updatedAt
  userId   String?
  expenses Expense[]

  @@unique([name, userId], name: "category_name_user_unique")
  @@index([userId])
  @@index([userId, updated], map: "category_user_id_updated_index")
}

model Income {
  id              Bytes           @id
  amount          Float
  description     String?         @db.VarChar(128)
  date            DateTime
  created         DateTime        @default(now())
  updated         DateTime        @updatedAt
  userId          String
  categoryId      Bytes?
  category        IncomeCategory? @relation(fields: [categoryId], references: [id])
  user            User            @relation(fields: [userId], references: [userId])
  // Set when a recurring rule generated this entry. Not a foreign key:
  // deleting a rule leaves its past entries untouched.
  recurringRuleId Bytes?
  occurrenceDate  DateTime?

  @@unique([recurringRuleId, occurrenceDate], map: "income_recurring_occurrence_unique")
  @@index([userId, date], map: "income_user_id_date_index")
  @@index([categoryId], map: "income_category_id_index")
  @@index([userId, updated], map: "income_user_id_updated_index")
}

model IncomeCategory {
  id      Bytes    @id
  name    String   @db.VarChar(128)
  icon    String   @db.VarChar(128)
  color   String   @db.VarChar(32)
  created DateTime @default(now())
  updated DateTime @updatedAt
  userId  String?
  incomes Income[]
  user    User?    @relation(fields: [userId], references: [userId])

  @@unique([name, userId], name: "income_category_name_user_unique")
  @@index([userId], map: "income_category_user_id_index")
  @@index([userId, updated], map: "income_category_user_id_updated_index")
}

model MonthlyLimit {
  id      Bytes    @id
  month   Int
  year    Int
  limit   Float
  userId  String
  created DateTime @default(now())
  updated DateTime @updatedAt
  user    User     @relation(fields: [userId], references: [userId])

  @@unique([userId, month, year], name: "user_month_year_unique")
  @@index([userId], map: "monthly_limit_user_id_index")
  @@index([userId, updated], map: "monthly_limit_user_id_updated_index")
}

model Loan {
  id             Bytes         @id
  loanType       LoanType
  name           String        @db.VarChar(128)
  amount         Float
  deadLine       DateTime?
  created        DateTime      @default(now())
  updated        DateTime      @updatedAt
  userId         String
  note           String?       @db.VarChar(512)
  settledAt      DateTime?
  countInBalance Boolean       @default(false)
  user           User          @relation(fields: [userId], references: [userId])
  payments       LoanPayment[]

  @@index([userId], map: "loan_user_id_index")
  @@index([userId, updated], map: "loan_user_id_updated_index")
}

model LoanPayment {
  id      Bytes    @id
  loanId  Bytes
  userId  String
  amount  Float
  date    DateTime
  note    String?  @db.VarChar(512)
  /// "repayment" pays the loan down; "topup" adds to it (borrowed or lent more).
  kind    String   @default("repayment") @db.VarChar(16)
  created DateTime @default(now())
  updated DateTime @updatedAt
  loan    Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)

  @@index([loanId], map: "loan_payment_loan_id_index")
  @@index([userId], map: "loan_payment_user_id_index")
  @@index([userId, updated], map: "loan_payment_user_id_updated_index")
  @@map("loan_payments")
}

model RecurringRule {
  id          Bytes     @id
  userId      String
  type        String    @db.VarChar(16)
  amount      Float
  description String?   @db.VarChar(128)
  // Expense or income category id, depending on type; not a foreign key.
  categoryId  Bytes?
  frequency   String    @db.VarChar(16)
  startDate   DateTime
  endDate     DateTime?
  pausedAt    DateTime?
  lastRunDate DateTime?
  created     DateTime  @default(now())
  updated     DateTime  @updatedAt

  @@index([userId], map: "recurring_rule_user_id_index")
  @@index([userId, updated], map: "recurring_rule_user_id_updated_index")
  @@map("recurring_rules")
}

model Invest {
  id        Bytes         @id
  name      String        @db.VarChar(128)
  note      String        @db.VarChar(512)
  status    EInvestStatus @default(ACTIVE)
  amount    Float
  startDate DateTime
  endDate   DateTime?
  userId    String
  created   DateTime      @default(now())
  updated   DateTime      @updatedAt
  earned    Float?
  user      User          @relation(fields: [userId], references: [userId])

  @@index([status, userId], map: "invest_status_userId_index")
  @@index([userId], map: "invest_user_id_index")
  @@index([userId, updated], map: "invest_user_id_updated_index")
}

/// Records a deleted row so the delta sync endpoint can tell other devices.
model Tombstone {
  entity  String   @db.VarChar(32)
  id      Bytes
  userId  String?
  deleted DateTime @default(now())

  @@id([entity, id])
  @@index([userId, deleted], map: "tombstone_user_id_deleted_index")
  @@map("tombstones")
}

/// Response of a POST sent with an Idempotency-Key, replayed on retries.
model IdempotencyKey {
  key     String   @id @db.VarChar(320)
  status  Int?
  body    Json?
  created DateTime @default(now())

  @@index([created], map: "idempotency_key_created_index")
  @@map("idempotency_keys")
}

enum LoanType {
  GIVEN
  TAKEN
}

enum EInvestStatus {
  ACTIVE
  COMPLETED
}
